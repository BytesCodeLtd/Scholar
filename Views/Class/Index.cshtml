@using Scholar.Common.Tables
@using Scholar.Constants
@using Scholar.Models.ViewModels
@model ClassIndexViewModel
@{
    ViewData["Title"] = "Classes";

    var builder = TableModel.For(Model.Classes)
                            .Title("Classes")
                            .WithSearch()
                            .WithCheckbox(show: true, valueProperty: nameof(ClassRow.Id))
                            .WithRowMenu(nameof(ClassRow.Id), RowMenus.Class())
                            .Column(TableColumns.Name, nameof(ClassRow.Name), sortable: true)
                            .Column(TableColumns.Sections, nameof(ClassRow.Sections));

    // SuperAdmins see classes from every institute, so show which one each belongs to.
    if (Model.IsSuperAdmin)
    {
        builder.Column(TableColumns.Institute, nameof(ClassRow.InstituteName), sortable: true);
    }

    builder.Column(TableColumns.Status, nameof(ClassRow.IsActive), sortable: true);

    TableModel table = builder.Build();
}

<div class="flex w-full flex-col space-y-5">
    <form asp-action="CreateOrUpdate" method="post"
          class="shrink-0 rounded-lg border border-gray-200 bg-white p-4 shadow-sm flex items-end gap-3 max-w-2xl">
        <div class="flex-1">
            <label for="sectionIds" class="block mb-1 text-sm font-medium text-gray-900">Sections</label>
            <select id="sectionIds" name="sectionIds" multiple required data-searchable data-placeholder="Select sections…"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-600 focus:border-brand-600 block w-full p-2.5">
                @foreach (var opt in Model.SectionOptions)
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            </select>
        </div>
        <div class="flex-1">
            <label for="name" class="block mb-1 text-sm font-medium text-gray-900">Class name</label>
            <input type="text" id="name" name="name" required maxlength="50"
                   placeholder="e.g. Grade 9"
                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-600 focus:border-brand-600 block w-full p-2.5" />
        </div>
        <button type="submit"
                class="text-white bg-brand-600 hover:bg-brand-700 font-medium rounded-lg text-sm px-5 py-2.5">
            Add
        </button>
    </form>

    @await Component.InvokeAsync("DataTable", new { model = table })
</div>
