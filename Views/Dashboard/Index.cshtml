@model Scholar.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Analytics & Insights";
    ViewData["HidePageHeader"] = true;
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Analytics & Insights</h1>
</div>

<!-- Stat cards (single row) -->
<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 @(Model.IsSuperAdmin ? "xl:grid-cols-6" : "xl:grid-cols-4")">
    @if (Model.IsSuperAdmin)
    {
        <!-- Total institutes -->
        <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
            <div class="flex items-start justify-between">
                <p class="text-sm font-semibold uppercase tracking-wide text-gray-400">Total institutes</p>
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-purple-50 text-purple-600 shrink-0">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M4 4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14h1a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1V4Zm3 1h2v2H7V5Zm0 4h2v2H7V9Zm4-4h2v2h-2V5Zm0 4h2v2h-2V9Zm-2 4a1 1 0 0 0-1 1v3h4v-3a1 1 0 0 0-1-1h-2Z" clip-rule="evenodd" />
                    </svg>
                </span>
            </div>
            <p class="mt-5 text-5xl font-semibold text-gray-900">@Model.TotalInstitutes.ToString("N0")</p>
        </div>

        <!-- Active institutes -->
        <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
            <div class="flex items-start justify-between">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Active institutes</p>
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                </span>
            </div>
            <p class="mt-5 text-5xl font-semibold text-gray-900">@Model.ActiveInstitutes.ToString("N0")</p>
        </div>
    }

    <!-- Total students -->
    <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Total students</p>
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-brand-50 text-brand-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m6-1.13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-1a3 3 0 1 0-2-5.24M6 12a3 3 0 1 0 2-5.24" /></svg>
            </span>
        </div>
        <p class="mt-5 text-5xl font-semibold text-gray-900">@Model.TotalStudents.ToString("N0")</p>
    </div>

    <!-- Faculty staff -->
    <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Faculty staff</p>
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14 3 9l9-5 9 5-9 5Zm0 0v6m6-9.333V16a6 6 0 0 1-12 0v-2.333" /></svg>
            </span>
        </div>
        <p class="mt-5 text-5xl font-semibold text-gray-900">@Model.TotalTeachers.ToString("N0")</p>
    </div>

    <!-- Question bank -->
    <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Question bank</p>
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-amber-50 text-amber-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3 2 8l10 5 10-5-10-5Zm0 8L2 16l10 5 10-5" /></svg>
            </span>
        </div>
        <p class="mt-5 text-5xl font-semibold text-gray-900">@Model.TotalQuestions.ToString("N0")</p>
    </div>

    <!-- Generated tests -->
    <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
        <div class="flex items-start justify-between">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Generated tests</p>
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-red-50 text-red-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" /></svg>
            </span>
        </div>
        <p class="mt-5 text-5xl font-semibold text-gray-900">@Model.TotalTests.ToString("N0")</p>
    </div>
</div>

@{
    string Pct(int part) => Model.TotalQuestions > 0 ? (part * 100.0 / Model.TotalQuestions).ToString("0.0") : "0.0";
}

<div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
    @if (Model.IsSuperAdmin)
    {
        <!-- Institute growth area chart -->
        <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
            <div class="flex justify-between mb-2">
                <div>
                    <h3 class="text-sm text-gray-500">Institute growth</h3>
                    <p class="text-2xl font-semibold text-gray-900 leading-none">@Model.TotalInstitutes</p>
                </div>
                <span class="text-xs font-medium text-gray-400">Last 6 months</span>
            </div>
            <div id="institute-area-chart"
                 data-height="380"
                 data-series="@System.Text.Json.JsonSerializer.Serialize(Model.InstituteChartData)"
                 data-labels="@System.Text.Json.JsonSerializer.Serialize(Model.InstituteChartLabels)"></div>
        </div>
    }

    <!-- Question repository donut chart -->
    <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
        <div class="mb-2">
            <h3 class="text-lg font-semibold text-gray-900">Question Bank</h3>
        </div>
        <div id="question-donut-chart" class="py-3"
             data-series="@System.Text.Json.JsonSerializer.Serialize(new[] { Model.TotalMcqs, Model.TotalShortQuestions, Model.TotalLongQuestions })"
             data-labels='@System.Text.Json.JsonSerializer.Serialize(new[] { "Multiple Choice (MCQ)", "Short Answer / Conceptual", "Long Essay & Problem" })'></div>
        <div class="mt-2 space-y-3">
            <div class="flex items-center justify-between text-sm">
                <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full" style="background:#1A56DB"></span>
                    <span class="font-medium text-gray-700">MCQs</span>
                </span>
                <span class="flex items-center gap-3">
                    <span class="font-semibold" style="color:#1A56DB">@Pct(Model.TotalMcqs)%</span>
                    <span class="font-medium text-gray-900">@Model.TotalMcqs.ToString("N0")</span>
                </span>
            </div>
            <div class="flex items-center justify-between text-sm">
                <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full" style="background:#057A55"></span>
                    <span class="font-medium text-gray-700">Short Questions</span>
                </span>
                <span class="flex items-center gap-3">
                    <span class="font-semibold" style="color:#057A55">@Pct(Model.TotalShortQuestions)%</span>
                    <span class="font-medium text-gray-900">@Model.TotalShortQuestions.ToString("N0")</span>
                </span>
            </div>
            <div class="flex items-center justify-between text-sm">
                <span class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full" style="background:#7E3AF2"></span>
                    <span class="font-medium text-gray-700">Long Questions</span>
                </span>
                <span class="flex items-center gap-3">
                    <span class="font-semibold" style="color:#7E3AF2">@Pct(Model.TotalLongQuestions)%</span>
                    <span class="font-medium text-gray-900">@Model.TotalLongQuestions.ToString("N0")</span>
                </span>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
@if (Model.IsSuperAdmin)
{
    <script src="~/js/institute-chart.js" asp-append-version="true"></script>
}
<script src="~/js/question-chart.js" asp-append-version="true"></script>
