@model IEnumerable<Scholar.Models.Question>

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center gap-3 px-6 py-14 text-center">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m21 21-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z" /></svg>
        </span>
        <div>
            <p class="text-sm font-medium text-gray-700">No questions found</p>
            <p class="mt-0.5 text-xs text-gray-400">Try widening your filters or choosing another topic.</p>
        </div>
    </div>
}
else
{
    <ul class="space-y-2 p-2">
        @foreach (var q in Model)
        {
            <li>
                @* Whole card is the label; has-[:checked] highlights it when its checkbox is ticked. *@
                <label class="group relative flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 bg-white p-3.5 transition
                              hover:border-gray-300 hover:bg-gray-50/80 hover:shadow-sm
                              has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/60 has-[:checked]:ring-1 has-[:checked]:ring-brand-500">
                    <input type="checkbox" class="pick-question mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-brand-600 focus:ring-brand-500 focus:ring-offset-0"
                           value="@q.Id" />
                    <span class="min-w-0 flex-1">
                        <span class="block text-sm font-medium leading-snug text-gray-900">@q.Text</span>

                        @if (q.Type == Scholar.Enums.QuestionType.Mcq && q.Options.Any())
                        {
                            <span class="mt-2.5 grid gap-1.5 sm:grid-cols-2">
                                @{ var letters = new[] { "A", "B", "C", "D", "E", "F" }; var i = 0; }
                                @foreach (var opt in q.Options)
                                {
                                    <span class="flex items-start gap-2 rounded-lg px-2 py-1 text-xs @(opt.IsCorrect ? "bg-emerald-50 text-emerald-800" : "text-gray-600")">
                                        <span class="mt-px inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full border text-[10px] font-semibold @(opt.IsCorrect ? "border-emerald-600 bg-emerald-600 text-white" : "border-gray-300 text-gray-500")">@(i < letters.Length ? letters[i] : "•")</span>
                                        <span class="min-w-0">@opt.Text</span>
                                        @if (opt.IsCorrect)
                                        {
                                            <svg class="ms-auto mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m5 13 4 4L19 7" /></svg>
                                        }
                                    </span>
                                    i++;
                                }
                            </span>
                        }

                        <span class="mt-2.5 flex flex-wrap items-center gap-1.5 text-xs">
                            @if (q.Type != Scholar.Enums.QuestionType.Mcq)
                            {
                                <span class="inline-flex items-center rounded-full bg-brand-50 px-2 py-0.5 font-medium text-brand-700">@q.Type</span>
                                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 font-medium text-amber-700">
                                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.37 4.22h4.44c.97 0 1.37 1.24.59 1.81l-3.6 2.61 1.38 4.23c.3.92-.76 1.68-1.54 1.11L10 14.31l-3.6 2.6c-.78.57-1.83-.19-1.54-1.11l1.38-4.23-3.6-2.61c-.78-.57-.38-1.81.59-1.81h4.44L9.05 2.93Z" /></svg>
                                    @q.Marks mark@(q.Marks == 1 ? "" : "s")
                                </span>
                            }
                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600">@q.Category</span>
                        </span>
                    </span>
                </label>
            </li>
        }
    </ul>
}
