@using Scholar.Common.Tables
@using Scholar.Constants
@using Scholar.Models.ViewModels
@model AttendanceRosterViewModel
@{
    ViewData["Title"] = "Attendance";
    string field = "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5";

    TableModel? table = null;

    if (Model.Loaded)
    {
        string date = Model.Date.ToString("yyyy-MM-dd");
        int gradeId = Model.GradeId!.Value;
        int? instituteId = Model.ShowInstitute ? Model.InstituteId : null;
        int page = Model.Roster.Page;

        RowMenuItem[] rowMenu = RowMenus.Attendance(date, gradeId, Model.Section, instituteId, page);

        var builder = TableModel.For(Model.Roster)
            .Title($"Attendance · {Model.Date:dddd, d MMM yyyy}")
            .WithCheckbox(show: true, valueProperty: nameof(AttendanceRosterRow.StudentId))
            .WithRowMenu(nameof(AttendanceRosterRow.StudentId), rowMenu)
            .Column(TableColumns.RollNumber, nameof(AttendanceRosterRow.RollNumber), sortable: true)
            .Column(TableColumns.Name, nameof(AttendanceRosterRow.Name), sortable: true)
            .Column(TableColumns.Section, nameof(AttendanceRosterRow.Section))
            .ButtonColumn(TableColumns.Status, nameof(AttendanceRosterRow.Status),
                CellButtons.Attendance(date, gradeId, Model.Section, instituteId, page));

        // "Mark whole class" buttons rendered as DataTable header actions.
        foreach (var action in TableActions.Attendance(date, gradeId, Model.Section, instituteId, page))
        {
            builder.WithAction(action);
        }

        table = builder.Build();
    }
}

<div class="flex w-full flex-col space-y-5 sm:flex-1 sm:min-h-0">

    @* Filters *@
    <form asp-controller="Attendance" asp-action="Index" method="get"
          class="shrink-0 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
            <div>
                <label class="mb-1 block text-sm font-medium text-gray-900">Date</label>
                <input name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="@field" />
            </div>

            @if (Model.ShowInstitute)
            {
                <div>
                    <label class="mb-1 block text-sm font-medium text-gray-900">Institute</label>
                    <select name="instituteId" asp-items="Model.InstituteOptions" class="@field">
                        <option value="">Select institute</option>
                    </select>
                </div>
            }

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-900">Class</label>
                <select name="gradeId" asp-items="Model.GradeOptions" class="@field">
                    <option value="">Select class</option>
                </select>
            </div>

            <div>
                <label class="mb-1 block text-sm font-medium text-gray-900">Section <span class="text-gray-400">(optional)</span></label>
                <input name="section" value="@Model.Section" placeholder="e.g. A" class="@field" />
            </div>

            <div class="flex items-end">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-brand-700 focus:ring-4 focus:ring-brand-100">
                    Search
                </button>
            </div>
        </div>
        @if (Model.ShowInstitute && Model.InstituteId is not null)
        {
            <input type="hidden" id="selInstitute" value="@Model.InstituteId" />
        }
        <input type="hidden" id="selGrade" value="@Model.GradeId" />
    </form>

    @if (Model.Loaded)
    {
        @await Component.InvokeAsync("DataTable", new { model = table })
    }
    else
    {
        <div class="rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center">
            <p class="text-sm font-medium text-gray-700">Pick a date and class, then click <span class="font-semibold">Load roster</span>.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // Restore the chosen institute/class selection after a GET reload.
            var g = document.getElementById('selGrade');
            if (g && g.value) { var gs = document.querySelector('select[name="gradeId"]'); if (gs) gs.value = g.value; }
            var inst = document.getElementById('selInstitute');
            if (inst && inst.value) { var is = document.querySelector('select[name="instituteId"]'); if (is) is.value = inst.value; }
        })();
    </script>
}
