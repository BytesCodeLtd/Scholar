@model IEnumerable<Chapter>
@{
    ViewData["Title"] = "Chapters";
    IEnumerable<Institute>? institutes = ViewBag.Institutes as IEnumerable<Institute>;
}

<style>
    /* Gentle reveal for the topics when a chapter expands. */
    details.chapter-item[open] > .chapter-body {
        animation: chapterReveal .2s ease-out;
    }

    @@keyframes chapterReveal {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

@if (!Model.Any())
{
    <div class="p-4 text-sm text-blue-800 rounded-lg bg-blue-50" role="alert">
        No chapters for this subject yet.
    </div>
}
else
{
    <form id="chapter-form" method="post" asp-controller="Test" asp-action="Create">
        <input type="hidden" name="subjectId" value="@ViewBag.SubjectId" />

        @if (institutes is not null)
        {
            <div class="mb-4 max-w-sm">
                <label for="instituteId" class="mb-1 block text-sm font-medium text-gray-900">Institute</label>
                <select id="instituteId" name="instituteId" required data-searchable
                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5">
                    <option value="" disabled selected>Select an institute…</option>
                    @foreach (var inst in institutes)
                    {
                        <option value="@inst.Id">@inst.Name</option>
                    }
                </select>
            </div>
        }

        <label class="mb-4 inline-flex items-center gap-2.5 text-sm font-medium text-gray-900 cursor-pointer">
            <input type="checkbox" id="select-all"
                   class="w-4 h-4 text-brand-600 bg-gray-100 border-gray-300 rounded focus:ring-brand-500" />
            Select all chapters &amp; topics
        </label>

        <div class="space-y-3">
            @foreach (var chapter in Model)
            {
                var topicCount = chapter.Topics.Count();
                <details class="chapter-item group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-200 open:border-brand-300 open:shadow-md hover:border-brand-200" open>
                    <summary class="flex items-center gap-4 p-4 cursor-pointer select-none list-none transition-colors duration-200 group-open:bg-gradient-to-r group-open:from-brand-50 group-open:to-transparent hover:bg-gray-50">
                        <input type="checkbox" id="chapter-@chapter.Id" name="selectedChapterIds" value="@chapter.Id"
                               onclick="event.stopPropagation();"
                               class="chapter-check w-4 h-4 text-brand-600 bg-gray-100 border-gray-300 rounded focus:ring-brand-500" />

                        <span class="inline-flex items-center justify-center w-10 h-10 shrink-0 rounded-xl bg-brand-50 text-brand-700 text-sm font-bold shadow-sm transition-colors duration-200 group-open:bg-brand-600 group-open:text-white">
                            @chapter.Number
                        </span>

                        <span class="flex-1 min-w-0">
                            <span class="block font-semibold text-gray-900 truncate group-open:text-brand-800">@chapter.Name</span>
                            <span class="block text-xs text-gray-400">@topicCount topic@(topicCount == 1 ? "" : "s")</span>
                        </span>

                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-gray-400 transition-all duration-200 group-hover:bg-white group-hover:text-gray-600 group-open:text-brand-600">
                            <svg class="w-4.5 h-4.5 transition-transform duration-200 group-open:rotate-180" fill="none"
                                 stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </span>
                    </summary>

                    @if (chapter.Topics.Any())
                    {
                        <div class="chapter-body px-4 pb-4 pt-1">
                            <div class="ml-2 space-y-0.5 pl-1">
                                @foreach (var topic in chapter.Topics.OrderBy(t => t.Number))
                                {
                                    <label for="topic-@topic.Id"
                                           class="flex items-center gap-3 rounded-lg px-2 py-2 cursor-pointer text-sm transition-colors hover:bg-brand-50/60">
                                        <input type="checkbox" id="topic-@topic.Id" name="selectedTopicIds" value="@topic.Id"
                                               data-chapter="@chapter.Id"
                                               class="topic-check w-4 h-4 text-brand-600 bg-gray-100 border-gray-300 rounded focus:ring-brand-500" />
                                        <span class="inline-flex items-center justify-center min-w-[2rem] h-6 px-1.5 shrink-0 rounded-md bg-gray-100 text-gray-500 text-xs font-semibold">@topic.Number</span>
                                        <span class="text-gray-800">@topic.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="chapter-body px-4 pb-4 pt-1">
                            <p class="ml-2 pl-1 py-2 text-sm text-gray-400">No topics in this chapter.</p>
                        </div>
                    }
                </details>
            }
        </div>

        <div class="mt-6">
            <button type="submit"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 focus:ring-4 focus:ring-brand-100">
                Next
            </button>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/chapter.js" asp-append-version="true"></script>
}
