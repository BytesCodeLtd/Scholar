@model Scholar.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["HidePageHeader"] = true;
}

<div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Dashboard</h1>
</div>

<div class="space-y-10">
    @if (Model.IsSuperAdmin)
    {
        <!-- Institutes section -->
        <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Institutes</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Total institutes -->
                <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                    <div class="flex items-center gap-4">
                        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-purple-50 text-purple-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0H5m14 0h2m-2 0h-4m-6 0H3m2 0h4m0 0v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4m-4 0h4M9 7h1m-1 4h1m4-4h1m-1 4h1" />
                            </svg>
                        </span>
                        <div>
                            <p class="text-sm text-gray-500">Total institutes</p>
                            <p class="text-3xl font-semibold text-gray-900">@Model.TotalInstitutes</p>
                        </div>
                    </div>
                </div>

                <!-- Active institutes -->
                <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                    <div class="flex items-center gap-4">
                        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-emerald-50 text-emerald-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                        </span>
                        <div>
                            <p class="text-sm text-gray-500">Active institutes</p>
                            <p class="text-3xl font-semibold text-gray-900">@Model.ActiveInstitutes</p>
                        </div>
                    </div>
                </div>

                <!-- Institutes added this month -->
                <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                    <div class="flex items-center gap-4">
                        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-green-50 text-green-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z" />
                            </svg>
                        </span>
                        <div>
                            <p class="text-sm text-gray-500">Added this month</p>
                            <p class="text-3xl font-semibold text-gray-900">@Model.InstitutesThisMonth</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Students section -->
    <section>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Students</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Total students -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-brand-50 text-brand-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m6-1.13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-1a3 3 0 1 0-2-5.24M6 12a3 3 0 1 0 2-5.24" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Total students</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TotalStudents</p>
                    </div>
                </div>
            </div>

            <!-- Students added this month -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-green-50 text-green-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Added this month</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.StudentsThisMonth</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Question bank section -->
    <section>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Question Bank Summary</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Total questions -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-brand-50 text-brand-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Total questions</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TotalQuestions</p>
                    </div>
                </div>
            </div>

            <!-- MCQs -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-blue-50 text-blue-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 12 2 2 4-4M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">MCQs</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TotalMcqs</p>
                    </div>
                </div>
            </div>

            <!-- Short questions -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-amber-50 text-amber-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 13h5m7-1a8 8 0 0 1-8 8H8l-4 3v-3a8 8 0 1 1 16-8Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Short questions</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TotalShortQuestions</p>
                    </div>
                </div>
            </div>

            <!-- Long questions -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-purple-50 text-purple-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 8h6m-6 4h6m-6 4h4M6 3h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Long questions</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TotalLongQuestions</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Tests section -->
    <section>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Tests</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Total tests -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-brand-50 text-brand-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Total tests</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TotalTests</p>
                    </div>
                </div>
            </div>

            <!-- Saved tests -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-emerald-50 text-emerald-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Saved tests</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.SavedTests</p>
                    </div>
                </div>
            </div>

            <!-- Tests generated this month -->
            <div class="rounded-lg bg-white border border-gray-200 shadow-sm p-6">
                <div class="flex items-center gap-4">
                    <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-green-50 text-green-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm text-gray-500">Generated this month</p>
                        <p class="text-3xl font-semibold text-gray-900">@Model.TestsThisMonth</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
