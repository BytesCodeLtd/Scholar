@using Scholar.Models.ViewModels
@model SectionFormViewModel
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Section" : "New Section";
}

<div class="p-4 max-w-lg">
    <h1 class="text-xl font-semibold text-gray-900">@ViewData["Title"]</h1>

    <form asp-action="CreateOrUpdate" method="post" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
        <input type="hidden" asp-for="Id" />

        @if (!isEdit && Model.IsSuperAdmin)
        {
            <div class="mb-4">
                <label for="instituteId" class="block mb-1 text-sm font-medium text-gray-900">Institute</label>
                <select id="instituteId" name="instituteId" required data-searchable data-placeholder="Search institute…"
                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-600 focus:border-brand-600 block w-full p-2.5">
                    <option value="">Select institute</option>
                    @foreach (var opt in Model.InstituteOptions)
                    {
                        <option value="@opt.Value">@opt.Text</option>
                    }
                </select>
            </div>
        }

        <div>
            <label asp-for="Name" class="block mb-1 text-sm font-medium text-gray-900">Section name</label>
            <input asp-for="Name" required maxlength="50" placeholder="e.g. A"
                   class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-600 focus:border-brand-600 block w-full p-2.5" />
        </div>

        <div class="mt-4 flex items-center gap-3">
            <button type="submit"
                    class="text-white bg-brand-600 hover:bg-brand-700 font-medium rounded-lg text-sm px-5 py-2.5">
                Save
            </button>
            <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900">Cancel</a>
        </div>
    </form>
</div>
