@model Scholar.Models.ViewModels.RegisterStudentViewModel
@{
    ViewData["Title"] = "Student Admission";

    // Shared control styles (kept in one place to avoid repetition).
    const string labelCls = "block mb-1 text-sm font-medium text-gray-700";
    const string inputCls = "bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5 placeholder:text-gray-400";
    const string selectCls = "bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5";
    const string errCls = "mt-1 block text-sm text-red-600";
    const string sectionCls = "rounded-lg bg-white border border-gray-200 shadow-sm";
    const string headerCls = "px-4 py-2.5 bg-gray-100 border-b border-gray-200 rounded-t-lg text-sm font-semibold text-gray-800";
    const string bodyCls = "p-4 md:p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-4";

    // Admission sessions: current and a couple of surrounding academic years.
    int year = DateTime.Today.Month >= 4 ? DateTime.Today.Year : DateTime.Today.Year - 1;
    var sessions = Enumerable.Range(-1, 3).Select(o => $"{year + o}-{(year + o + 1) % 100:00}").ToList();
    var bloodGroups = new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" };
    var religions = new[] { "Islam", "Christianity", "Hinduism", "Sikhism", "Other" };
    var categories = new[] { "New", "Old", "Orphan", "Staff Child", "Scholarship" };
    var concessions = new[] { "None", "Sibling", "Merit", "Staff", "Financial" };
}

<form asp-controller="Student" asp-action="Register" method="post" enctype="multipart/form-data" class="space-y-5">
    <div asp-validation-summary="ModelOnly"
         class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3"></div>

    @* ---------- Student Admission ---------- *@
    <section class="@sectionCls">
        <div class="@headerCls">Student Admission</div>
        <div class="@bodyCls">
            <div>
                <label asp-for="AdmissionNumber" class="@labelCls">Admission Number <span class="text-red-500">*</span></label>
                <input asp-for="AdmissionNumber" class="@inputCls" />
                @if (!string.IsNullOrWhiteSpace(Model.LastAdmissionNumber))
                {
                    <span class="mt-1 block text-xs text-gray-500">Last Admission # @Model.LastAdmissionNumber</span>
                }
                <span asp-validation-for="AdmissionNumber" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="RollNumber" class="@labelCls"></label>
                <input asp-for="RollNumber" class="@inputCls" />
                @if (!string.IsNullOrWhiteSpace(Model.LastRollNumber))
                {
                    <span class="mt-1 block text-xs text-gray-500">Last Roll # @Model.LastRollNumber</span>
                }
                <span asp-validation-for="RollNumber" class="@errCls"></span>
            </div>

            <div class="lg:col-span-2">
                <label asp-for="AdmissionSession" class="@labelCls"></label>
                <select asp-for="AdmissionSession" class="@selectCls">
                    <option value="">Select</option>
                    @foreach (var s in sessions)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <span asp-validation-for="AdmissionSession" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="GradeId" class="@labelCls">Class <span class="text-red-500">*</span></label>
                <select asp-for="GradeId" class="@selectCls" data-adm-class>
                    <option value="">Select</option>
                    @foreach (var c in Model.ClassOptions)
                    {
                        <option value="@c.Id" data-sections="@string.Join(",", c.Sections)">@c.Name</option>
                    }
                </select>
                <span asp-validation-for="GradeId" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="Section" class="@labelCls"></label>
                @* Options are filled from the selected class's linked sections (see script below). *@
                <select asp-for="Section" class="@selectCls" data-adm-section data-selected="@Model.Section">
                    <option value="">Select</option>
                </select>
                <span asp-validation-for="Section" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="FirstName" class="@labelCls">First Name <span class="text-red-500">*</span></label>
                <input asp-for="FirstName" class="@inputCls" />
                <span asp-validation-for="FirstName" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="LastName" class="@labelCls"></label>
                <input asp-for="LastName" class="@inputCls" />
                <span asp-validation-for="LastName" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="Gender" class="@labelCls">Gender <span class="text-red-500">*</span></label>
                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Scholar.Enums.Gender>()" class="@selectCls">
                    <option value="">Select</option>
                </select>
                <span asp-validation-for="Gender" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="DateOfBirth" class="@labelCls">Date Of Birth <span class="text-red-500">*</span></label>
                <input asp-for="DateOfBirth" type="date" class="@inputCls" />
                <span asp-validation-for="DateOfBirth" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="Category" class="@labelCls"></label>
                <select asp-for="Category" class="@selectCls">
                    <option value="">Select</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
                <span asp-validation-for="Category" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="Religion" class="@labelCls"></label>
                <select asp-for="Religion" class="@selectCls">
                    @foreach (var r in religions)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
                <span asp-validation-for="Religion" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="MobileNumber" class="@labelCls">Mobile Number <span class="text-red-500">*</span></label>
                <input asp-for="MobileNumber" class="@inputCls" placeholder="03xx-xxxxxxx" />
                <span asp-validation-for="MobileNumber" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="Email" class="@labelCls"></label>
                <input asp-for="Email" class="@inputCls" />
                <span asp-validation-for="Email" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="AdmissionDate" class="@labelCls">Admission Date <span class="text-red-500">*</span></label>
                <input asp-for="AdmissionDate" type="date" class="@inputCls" />
                <span asp-validation-for="AdmissionDate" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="StudentPhoto" class="@labelCls"></label>
                <partial name="_PhotoDrop" model="(nameof(Model.StudentPhoto), (string?)null)" />
            </div>

            <div>
                <label asp-for="Caste" class="@labelCls"></label>
                <input asp-for="Caste" class="@inputCls" />
            </div>

            <div>
                <label asp-for="BloodGroup" class="@labelCls"></label>
                <select asp-for="BloodGroup" class="@selectCls">
                    <option value="">Select</option>
                    @foreach (var b in bloodGroups)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>

            <div>
                <label asp-for="Height" class="@labelCls"></label>
                <input asp-for="Height" class="@inputCls" />
            </div>

            <div>
                <label asp-for="Weight" class="@labelCls"></label>
                <input asp-for="Weight" class="@inputCls" />
            </div>

            <div>
                <label asp-for="FamilyNo" class="@labelCls"></label>
                <input asp-for="FamilyNo" class="@inputCls" />
            </div>

            <div>
                <label asp-for="IsFamilyHead" class="@labelCls"></label>
                <select asp-for="IsFamilyHead" class="@selectCls">
                    <option value="">Select</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>

            @if (Model.ShowInstitute)
            {
                <div>
                    <label asp-for="InstituteId" class="@labelCls">Academy <span class="text-red-500">*</span></label>
                    <select asp-for="InstituteId" asp-items="Model.InstituteOptions" class="@selectCls">
                        <option value="">Select</option>
                    </select>
                    <span asp-validation-for="InstituteId" class="@errCls"></span>
                </div>
            }

            <div>
                <label asp-for="AsOnDate" class="@labelCls"></label>
                <input asp-for="AsOnDate" type="date" class="@inputCls" />
            </div>

            <div>
                <label asp-for="BFormCnic" class="@labelCls"></label>
                <input asp-for="BFormCnic" class="@inputCls" />
            </div>

            <div>
                <label asp-for="WhatsappNumber" class="@labelCls"></label>
                <input asp-for="WhatsappNumber" class="@inputCls" />
            </div>

            <div>
                <label asp-for="CardId" class="@labelCls"></label>
                <input asp-for="CardId" class="@inputCls" />
            </div>

            <div>
                <label asp-for="RefBy" class="@labelCls"></label>
                <input asp-for="RefBy" class="@inputCls" />
            </div>

            <div>
                <label asp-for="LastClassAttended" class="@labelCls"></label>
                <input asp-for="LastClassAttended" class="@inputCls" />
            </div>

            <div class="lg:col-span-2">
                <label asp-for="PreviousSchoolDetails" class="@labelCls"></label>
                <textarea asp-for="PreviousSchoolDetails" rows="2" class="@inputCls"></textarea>
            </div>

            <div class="flex items-end">
                <button type="button" id="add-sibling"
                        class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-brand-600 hover:text-brand-700">
                    <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14" />
                    </svg>
                    Add Sibling
                </button>
            </div>
        </div>
    </section>

    @* ---------- Parent / Guardian Detail ---------- *@
    <section class="@sectionCls">
        <div class="@headerCls">Parent Guardian Detail</div>
        <div class="@bodyCls">
            <div>
                <label asp-for="FatherName" class="@labelCls"></label>
                <input asp-for="FatherName" class="@inputCls" />
            </div>
            <div>
                <label asp-for="FatherCnic" class="@labelCls"></label>
                <input asp-for="FatherCnic" class="@inputCls" />
            </div>
            <div>
                <label asp-for="FatherPhone" class="@labelCls"></label>
                <input asp-for="FatherPhone" class="@inputCls" />
            </div>
            <div>
                <label asp-for="FatherOccupation" class="@labelCls"></label>
                <input asp-for="FatherOccupation" class="@inputCls" />
            </div>

            <div>
                <label asp-for="MotherName" class="@labelCls"></label>
                <input asp-for="MotherName" class="@inputCls" />
            </div>
            <div>
                <label asp-for="MotherCnic" class="@labelCls"></label>
                <input asp-for="MotherCnic" class="@inputCls" />
            </div>
            <div>
                <label asp-for="MotherPhone" class="@labelCls"></label>
                <input asp-for="MotherPhone" class="@inputCls" />
            </div>
            <div>
                <label asp-for="MotherOccupation" class="@labelCls"></label>
                <input asp-for="MotherOccupation" class="@inputCls" />
            </div>

            <div>
                <label asp-for="FatherPhoto" class="@labelCls"></label>
                <partial name="_PhotoDrop" model="(nameof(Model.FatherPhoto), (string?)null)" />
            </div>
            <div>
                <label asp-for="MotherPhoto" class="@labelCls"></label>
                <partial name="_PhotoDrop" model="(nameof(Model.MotherPhoto), (string?)null)" />
            </div>

            <div class="sm:col-span-2 lg:col-span-4">
                <span class="@labelCls">If Guardian Is <span class="text-red-500">*</span></span>
                <div class="flex items-center gap-6 pt-1">
                    @foreach (var gt in Enum.GetValues<Scholar.Enums.GuardianType>())
                    {
                        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" asp-for="GuardianType" value="@gt"
                                   class="w-4 h-4 text-brand-600 border-gray-300 focus:ring-brand-500" />
                            @gt
                        </label>
                    }
                </div>
                <span asp-validation-for="GuardianType" class="@errCls"></span>
            </div>

            <div>
                <label asp-for="GuardianName" class="@labelCls">Guardian Name <span class="text-red-500">*</span></label>
                <input asp-for="GuardianName" class="@inputCls" />
                <span asp-validation-for="GuardianName" class="@errCls"></span>
            </div>
            <div>
                <label asp-for="GuardianRelation" class="@labelCls"></label>
                <input asp-for="GuardianRelation" class="@inputCls" />
            </div>
            <div>
                <label asp-for="GuardianEmail" class="@labelCls"></label>
                <input asp-for="GuardianEmail" class="@inputCls" />
                <span asp-validation-for="GuardianEmail" class="@errCls"></span>
            </div>
            <div>
                <label asp-for="GuardianPhoto" class="@labelCls"></label>
                <partial name="_PhotoDrop" model="(nameof(Model.GuardianPhoto), (string?)null)" />
            </div>

            <div>
                <label asp-for="GuardianPhone" class="@labelCls">Guardian Phone <span class="text-red-500">*</span></label>
                <input asp-for="GuardianPhone" class="@inputCls" />
                <span asp-validation-for="GuardianPhone" class="@errCls"></span>
            </div>
            <div>
                <label asp-for="GuardianOccupation" class="@labelCls"></label>
                <input asp-for="GuardianOccupation" class="@inputCls" />
            </div>
            <div class="sm:col-span-2">
                <label asp-for="GuardianAddress" class="@labelCls"></label>
                <textarea asp-for="GuardianAddress" rows="2" class="@inputCls"></textarea>
            </div>
        </div>
    </section>

    @* ---------- Fee Details ---------- *@
    <section class="@sectionCls">
        <div class="@headerCls">Fee Details</div>
        <div class="p-4 md:p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-4">
            <div>
                <label asp-for="ConcessionType" class="@labelCls"></label>
                <select asp-for="ConcessionType" class="@selectCls">
                    <option value="">Select concession type</option>
                    @foreach (var c in concessions)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="ConcessionValidTill" class="@labelCls"></label>
                <input asp-for="ConcessionValidTill" type="date" class="@inputCls" />
            </div>
            <div>
                <label asp-for="TuitionFeeHead" class="@labelCls"></label>
                <input asp-for="TuitionFeeHead" class="@inputCls" />
            </div>
            <div>
                <label asp-for="AdmissionHead" class="@labelCls"></label>
                <input asp-for="AdmissionHead" class="@inputCls" />
            </div>
            <div>
                <label asp-for="AdmissionDiscount" class="@labelCls"></label>
                <input asp-for="AdmissionDiscount" type="number" step="0.01" min="0" class="@inputCls" />
                <span asp-validation-for="AdmissionDiscount" class="@errCls"></span>
            </div>
            <div class="sm:col-span-2 lg:col-span-3">
                <label asp-for="TermsAndConditions" class="@labelCls"></label>
                <textarea asp-for="TermsAndConditions" rows="3" class="@inputCls"></textarea>
            </div>
        </div>
    </section>

    <div class="flex items-center justify-end gap-3">
        <a asp-controller="Student" asp-action="Index"
           class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
            Cancel
        </a>
        <button type="submit"
                class="inline-flex items-center px-5 py-2 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 focus:ring-4 focus:ring-brand-100">
            Save
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Section options follow the chosen class (its sections are in data-sections).
        (function () {
            const cls = document.querySelector('[data-adm-class]');
            const sec = document.querySelector('[data-adm-section]');
            if (!cls || !sec) return;
            const chosen = sec.dataset.selected || '';
            const fill = () => sec.innerHTML = '<option value="">Select</option>' +
                (cls.selectedOptions[0]?.dataset.sections || '').split(',').filter(Boolean)
                    .map(n => `<option${n === chosen ? ' selected' : ''}>${n}</option>`).join('');
            cls.addEventListener('change', fill);
            fill();
        })();
    </script>
    <script>
        // Show the chosen file name inside each drag-and-drop photo box.
        document.querySelectorAll('[data-photo-drop] input[type=file]').forEach(function (input) {
            var box = input.closest('[data-photo-drop]');
            var label = box.querySelector('[data-photo-label]');
            var defaultText = label.textContent;
            input.addEventListener('change', function () {
                label.textContent = input.files.length ? input.files[0].name : defaultText;
            });
            ['dragover', 'dragenter'].forEach(e => box.addEventListener(e, ev => { ev.preventDefault(); box.classList.add('border-brand-400'); }));
            ['dragleave', 'drop'].forEach(e => box.addEventListener(e, ev => { ev.preventDefault(); box.classList.remove('border-brand-400'); }));
            box.addEventListener('drop', function (ev) {
                if (ev.dataTransfer.files.length) { input.files = ev.dataTransfer.files; input.dispatchEvent(new Event('change')); }
            });
        });
    </script>
}
