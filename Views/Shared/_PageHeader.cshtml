@{
    var pageTitle = ViewData["Title"] as string;
    var pageSubtitle = ViewData["PageSubtitle"] as string;
}

<div class="mb-6 flex items-center gap-3 print:hidden">
    <button type="button" onclick="history.back()"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-600 hover:bg-gray-50 hover:text-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-100"
            aria-label="Go back" title="Go back">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
    </button>
    <div class="min-w-0">
        <h1 class="text-2xl font-semibold text-gray-900 truncate">@pageTitle</h1>
        @if (!string.IsNullOrEmpty(pageSubtitle))
        {
            <p class="text-sm text-gray-500">@pageSubtitle</p>
        }
    </div>
</div>
