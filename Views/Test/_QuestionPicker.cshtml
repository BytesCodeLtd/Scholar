@model IEnumerable<Scholar.Models.Question>

@if (!Model.Any())
{
    <div class="p-4 text-center text-sm text-gray-500">No questions found for the selected filters.</div>
}
else
{
    <ul class="divide-y divide-gray-100">
        @foreach (var q in Model)
        {
            <li class="p-3">
                <label class="flex items-start gap-3 cursor-pointer">
                    <input type="checkbox" class="pick-question mt-1 h-4 w-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500"
                           value="@q.Id" />
                    <span class="min-w-0 flex-1">
                        <span class="block text-gray-800">@q.Text</span>
                        @if (q.Type == Scholar.Enums.QuestionType.Mcq && q.Options.Any())
                        {
                            <span class="mt-2 grid gap-1 sm:grid-cols-2">
                                @{ var letters = new[] { "A", "B", "C", "D", "E", "F" }; var i = 0; }
                                @foreach (var opt in q.Options)
                                {
                                    <span class="flex items-start gap-2 text-xs @(opt.IsCorrect ? "text-brand-700 font-medium" : "text-gray-600")">
                                        <span class="mt-px inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full border text-[10px] @(opt.IsCorrect ? "border-brand-600 bg-brand-50 text-brand-700" : "border-gray-300 text-gray-500")">@(i < letters.Length ? letters[i] : "•")</span>
                                        <span class="min-w-0">@opt.Text</span>
                                    </span>
                                    i++;
                                }
                            </span>
                        }
                        <span class="mt-1.5 inline-flex items-center gap-2 text-xs text-gray-500">
                            <span class="rounded bg-brand-50 px-2 py-0.5 font-medium text-brand-700">@q.Type</span>
                            <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">@q.Category</span>
                            <span>@q.Marks mark@(q.Marks == 1 ? "" : "s")</span>
                            @if (q.Type == Scholar.Enums.QuestionType.Mcq)
                            {
                                <span>· @q.Options.Count options</span>
                            }
                        </span>
                    </span>
                </label>
            </li>
        }
    </ul>
}
