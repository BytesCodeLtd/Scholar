@{
    // Keep the Papers dropdown expanded when the current page is one of its children.
    // Institute serves both the Institutes tab and Paper Settings, so only its
    // PaperSettings action counts as a paper page.
    string? currentController = ViewContext.RouteData.Values["controller"] as string;
    string? currentAction = ViewContext.RouteData.Values["action"] as string;
    string[] paperControllers = { "Board", "Grade", "Subject", "Chapter", "Test", "PastPaper" };
    bool papersOpen = (currentController is not null && paperControllers.Contains(currentController))
                      || (currentController == "Institute" && currentAction == "PaperSettings");
}
<aside id="sidebar" aria-label="Sidebar"
       class="fixed top-0 left-0 z-40 w-64 h-screen pt-14 transition-transform -translate-x-full sm:translate-x-0">
    <div class="h-full px-3 py-4 overflow-y-auto bg-white border-r border-gray-200">
        <ul class="space-y-2 font-medium">
            <li>
                <a asp-controller="Dashboard" asp-action="Index"
                   class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                    <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z" />
                    </svg>
                    <span class="ms-3">Dashboard</span>
                </a>
            </li>

            <li>
                <button type="button"
                        class="flex items-center w-full p-2 text-gray-900 rounded-lg group hover:bg-gray-100"
                        aria-controls="dropdown-papers" data-collapse-toggle="dropdown-papers"
                        aria-expanded="@(papersOpen ? "true" : "false")">
                    <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M5 0h6.293A1 1 0 0 1 12 .293L15.707 4a1 1 0 0 1 .293.707V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2Zm2 9a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2H7Zm0 4a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2H7Z" />
                    </svg>
                    <span class="flex-1 ms-3 text-left whitespace-nowrap">Examination</span>
                    <svg class="w-3 h-3 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4" />
                    </svg>
                </button>
                <ul id="dropdown-papers" class="@(papersOpen ? "" : "hidden") py-2 space-y-2">
                    <li>
                        <a asp-controller="Board" asp-action="Index"
                           class="flex items-center w-full p-2 text-gray-900 transition duration-75 rounded-lg pl-11 hover:bg-gray-100">Generate Paper</a>
                    </li>
                    <li>
                        <a asp-controller="Test" asp-action="Index"
                           class="flex items-center w-full p-2 text-gray-900 transition duration-75 rounded-lg pl-11 hover:bg-gray-100">Saved Papers</a>
                    </li>
                    @if (User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.InstituteAdmin))
                    {
                        <li>
                            <a asp-controller="PastPaper" asp-action="Index"
                               class="flex items-center w-full p-2 text-gray-900 transition duration-75 rounded-lg pl-11 hover:bg-gray-100">Past Papers</a>
                        </li>
                        @if (User.IsInRole(Roles.SuperAdmin))
                        {
                            <li>
                                <a asp-controller="PastPaper" asp-action="Manage"
                                   class="flex items-center w-full p-2 text-gray-900 transition duration-75 rounded-lg pl-11 hover:bg-gray-100">Upload Past Papers</a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Institute" asp-action="PaperSettings"
                               class="flex items-center w-full p-2 text-gray-900 transition duration-75 rounded-lg pl-11 hover:bg-gray-100">Paper Settings</a>
                        </li>
                    }
                </ul>
            </li>

            @if (User.IsInRole(Roles.SuperAdmin))
            {
                <li>
                    <a asp-controller="Institute" asp-action="List"
                       class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                        <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm1 15a1 1 0 0 1-2 0v-4H5a1 1 0 0 1 0-2h4V5a1 1 0 0 1 2 0v4h4a1 1 0 1 1 0 2h-4v4Z" />
                        </svg>
                        <span class="ms-3">Institutes</span>
                    </a>
                </li>
            }
            @if (User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.InstituteAdmin))
            {
                <li>
                    <a asp-controller="Student" asp-action="Index"
                       class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                        <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-2 1a5.977 5.977 0 0 0-4.242 1.758A6 6 0 0 0 2 16v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1a6 6 0 0 0-1.758-4.242A5.977 5.977 0 0 0 12 10H8Z" />
                        </svg>
                        <span class="ms-3">Students</span>
                    </a>
                </li>
            }
            <li>
                <a asp-controller="Teacher" asp-action="Index"
                   class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                    <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17 5.923A1 1 0 0 0 16 5h-3V4a4 4 0 1 0-8 0v1H2a1 1 0 0 0-1 .923L.086 17.846A2 2 0 0 0 2.08 20h15.84a2 2 0 0 0 1.994-2.153L17 5.923ZM7 9a1 1 0 0 1-2 0V7h2v2Zm0-5a2 2 0 1 1 4 0v1H7V4Zm6 5a1 1 0 1 1-2 0V7h2v2Z" />
                    </svg>
                    <span class="ms-3">Teachers</span>
                </a>
            </li>
        </ul>
    </div>
</aside>
