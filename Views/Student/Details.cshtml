@using Scholar.Constants
@model Scholar.Models.ViewModels.StudentDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
    ViewData["HidePageHeader"] = true;

    bool isSuperAdmin = User.IsInRole(Roles.SuperAdmin);

    // A label/value row. Supported:false means the field isn't tracked by the system yet,
    // so it renders muted as "Not available" instead of a real value.
    Func<(string Label, string? Value, bool Supported), object> Row =
    @<div class="flex items-center justify-between gap-4 py-2.5">
        <dt class="text-sm text-gray-500">@item.Label</dt>
        <dd class="text-right text-sm font-medium @(item.Supported ? "text-gray-900" : "text-gray-300")">
            @(item.Supported ? (string.IsNullOrWhiteSpace(item.Value) ? "—" : item.Value) : "Not available")
        </dd>
    </div>;

    // A stat tile the system doesn't yet compute — shown in the mock's layout but disabled.
    Func<(string Label, string Tint, string Icon), object> Stat =
    @<div class="rounded-xl border border-gray-200 bg-white p-4">
        <div class="flex items-center gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg @item.Tint">
                <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">@Html.Raw(item.Icon)</svg>
            </span>
            <div>
                <p class="text-lg font-bold leading-none text-gray-300">—</p>
                <p class="mt-1 text-xs font-medium text-gray-500">@item.Label</p>
            </div>
        </div>
        <p class="mt-2 text-[11px] text-gray-400">Not tracked yet</p>
    </div>;
}

<div class="mx-auto w-full max-w-7xl space-y-5">
    @* Breadcrumb + back *@
    <div class="flex items-center gap-2 text-sm text-gray-500">
        <a asp-controller="Student" asp-action="Index" class="rounded hover:text-brand-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-100">Students</a>
        <span class="text-gray-300">/</span>
        <span class="font-medium text-gray-700">@Model.FullName</span>
    </div>

    @* ─────────────────────────── Profile header ─────────────────────────── *@
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="relative bg-gradient-to-br from-brand-700 to-brand-600 px-6 py-6 sm:px-8">
            <span aria-hidden="true" class="pointer-events-none absolute -right-10 -top-12 h-44 w-44 rounded-full border border-white/10"></span>
            <span aria-hidden="true" class="pointer-events-none absolute -right-2 -top-4 h-28 w-28 rounded-full border border-white/10"></span>

            <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-2xl font-semibold text-white ring-1 ring-inset ring-white/25">
                        @Model.Initials
                    </span>
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h1 class="text-2xl font-semibold tracking-tight text-white">@Model.FullName</h1>
                            @if (Model.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium text-white ring-1 ring-inset ring-white/20">
                                    <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-black/15 px-2.5 py-0.5 text-xs font-medium text-white/80 ring-1 ring-inset ring-white/15">
                                    <span class="h-1.5 w-1.5 rounded-full bg-gray-300"></span>Inactive
                                </span>
                            }
                        </div>
                        <p class="mt-1 text-sm text-brand-100">
                            @Model.Class@(string.IsNullOrWhiteSpace(Model.Section) ? "" : " · Section " + Model.Section)@(isSuperAdmin && !string.IsNullOrWhiteSpace(Model.Institute) ? " · " + Model.Institute : "")
                        </p>
                        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-brand-100">
                            <span class="inline-flex items-center gap-1.5">
                                <svg class="h-3.5 w-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.4 18.2a12 12 0 0 1-11.6-11.6c0-.8.6-1.5 1.4-1.6l2-.3a1 1 0 0 1 1.1.7l.8 2.6a1 1 0 0 1-.4 1.1l-1 .7a9 9 0 0 0 3.9 3.9l.7-1a1 1 0 0 1 1.1-.4l2.6.8a1 1 0 0 1 .7 1.1l-.3 2c-.1.8-.8 1.4-1.6 1.4Z"/></svg>
                                @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "No phone on file" : Model.PhoneNumber)
                            </span>
                            <span class="inline-flex items-center gap-1.5 text-brand-100/60">
                                <svg class="h-3.5 w-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 7 8.2 5.5c.5.3 1.1.3 1.6 0L21 7M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
                                No email on file
                            </span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row sm:items-center lg:flex-col lg:items-end">
                    <div class="inline-flex items-center gap-3 self-start rounded-xl bg-white/10 px-4 py-2.5 ring-1 ring-inset ring-white/20 lg:self-end">
                        <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-100">Roll No</span>
                        <span class="font-mono text-xl font-semibold tracking-[0.18em] text-white">@(string.IsNullOrWhiteSpace(Model.RollNumber) ? "—" : Model.RollNumber)</span>
                    </div>
                    <div class="flex items-center gap-2">
                        @* No student edit/print actions exist yet — shown but disabled. *@
                        <button type="button" disabled title="Not available yet"
                                class="inline-flex cursor-not-allowed items-center gap-2 rounded-lg bg-white/10 px-3.5 py-2 text-sm font-medium text-white/50 ring-1 ring-inset ring-white/15">
                            <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.4 6 18 7.6M6 16v2h2l9.4-9.4a1.4 1.4 0 0 0 0-2L15.8 5a1.4 1.4 0 0 0-2 0L6 14v2Z"/></svg>
                            Edit profile
                        </button>
                        @if (Model.IsActive)
                        {
                            <form asp-controller="Student" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                                  onsubmit="return confirm('Deactivate this student? You can reactivate them anytime.');">
                                <button type="submit"
                                        class="inline-flex items-center gap-2 rounded-lg bg-white px-3.5 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-white/40">
                                    <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                    Deactivate
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Student" asp-action="Activate" asp-route-id="@Model.Id" method="post">
                                <button type="submit"
                                        class="inline-flex items-center gap-2 rounded-lg bg-white px-3.5 py-2 text-sm font-medium text-brand-700 hover:bg-brand-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-white/40">
                                    <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11.9 9.2 16 19 6"/></svg>
                                    Activate
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Tabs — only Overview is backed by data today. *@
        <nav class="flex gap-6 overflow-x-auto border-b border-gray-200 px-6 sm:px-8">
            <span class="whitespace-nowrap border-b-2 border-brand-600 py-3 text-sm font-medium text-brand-700">Student overview</span>
            <span class="whitespace-nowrap border-b-2 border-transparent py-3 text-sm font-medium text-gray-300" title="Not available yet">Performance &amp; grades</span>
            <span class="whitespace-nowrap border-b-2 border-transparent py-3 text-sm font-medium text-gray-300" title="Not available yet">Attendance</span>
            <span class="whitespace-nowrap border-b-2 border-transparent py-3 text-sm font-medium text-gray-300" title="Not available yet">Documents &amp; forms</span>
        </nav>
    </section>

    @* ─────────────────────────── KPI tiles (not tracked yet) ─────────────────────────── *@
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @Stat(("Attendance", "bg-green-50 text-green-600", "<path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 3v4m8-4v4M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 9 2 2 4-4\"/>"))
        @Stat(("Class rank", "bg-brand-50 text-brand-600", "<path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 5H5v3a4 4 0 0 0 4 4m6-7h3v3a4 4 0 0 1-4 4m-3 0v3m0 0a3 3 0 0 0-3 3h6a3 3 0 0 0-3-3ZM8 4h8v4a4 4 0 1 1-8 0V4Z\"/>"))
        @Stat(("Overall average", "bg-blue-50 text-blue-600", "<path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 19V5m0 14 4-4 3 2 5-6 4 4\"/>"))
        @Stat(("Fee status", "bg-teal-50 text-teal-600", "<path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm12 6h.01M3 10h18\"/>"))
    </div>

    @* ─────────────────────────── Main grid ─────────────────────────── *@
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        <div class="space-y-5 lg:col-span-2">
            @* Academic enrollment *@
            <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
                <header class="flex items-center gap-2 border-b border-gray-100 px-6 py-4">
                    <span class="h-4 w-0.5 rounded-full bg-brand-500"></span>
                    <h2 class="text-sm font-semibold text-gray-900">Academic enrollment</h2>
                </header>
                <div class="grid grid-cols-1 gap-x-10 px-6 py-2 sm:grid-cols-2">
                    <dl class="divide-y divide-gray-100">
                        @Row(("Class", Model.Class, true))
                        @Row(("Section", Model.Section, true))
                        @Row(("Roll number", Model.RollNumber, true))
                    </dl>
                    <dl class="divide-y divide-gray-100">
                        @Row(("Institute", Model.Institute, true))
                        @Row(("Subject group", null, false))
                        @Row(("Admission session", null, false))
                    </dl>
                </div>
            </section>

            @* Personal & identity *@
            <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
                <header class="flex items-center gap-2 border-b border-gray-100 px-6 py-4">
                    <span class="h-4 w-0.5 rounded-full bg-brand-500"></span>
                    <h2 class="text-sm font-semibold text-gray-900">Personal &amp; identity profile</h2>
                </header>
                <div class="grid grid-cols-1 gap-x-10 px-6 py-2 sm:grid-cols-2">
                    <dl class="divide-y divide-gray-100">
                        @Row(("Full name", Model.FullName, true))
                        @Row(("Gender", Model.Gender?.ToString(), true))
                        @Row(("Date of birth", Model.DateOfBirth?.ToString("d MMM yyyy"), true))
                        @Row(("Age", Model.Age is int a ? $"{a} years" : null, true))
                    </dl>
                    <dl class="divide-y divide-gray-100">
                        @Row(("Address", null, false))
                        @Row(("B-Form / CNIC", null, false))
                        @Row(("Email", null, false))
                        @Row(("Added on", Model.CreatedAt == default ? null : Model.CreatedAt.ToString("d MMM yyyy"), true))
                    </dl>
                </div>
            </section>

            @* Enrolled subjects & term performance — no data yet *@
            <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
                <header class="flex items-center gap-2 border-b border-gray-100 px-6 py-4">
                    <span class="h-4 w-0.5 rounded-full bg-brand-500"></span>
                    <h2 class="text-sm font-semibold text-gray-900">Enrolled subjects &amp; term performance</h2>
                </header>
                <div class="px-6 py-10 text-center">
                    <span class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-full bg-gray-100 text-gray-400">
                        <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 8h6M9 12h6m-6 4h4M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/></svg>
                    </span>
                    <p class="mt-3 text-sm font-medium text-gray-700">No subject records yet</p>
                    <p class="mt-1 text-xs text-gray-400">Term marks and grades will appear here once results are recorded.</p>
                </div>
            </section>
        </div>

        @* Right rail *@
        <div class="space-y-5">
            @* Guardian contact *@
            <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
                <header class="flex items-center gap-2 border-b border-gray-100 px-6 py-4">
                    <span class="h-4 w-0.5 rounded-full bg-brand-500"></span>
                    <h2 class="text-sm font-semibold text-gray-900">Guardian contact</h2>
                </header>
                <div class="px-6 py-5">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-50 text-sm font-semibold text-brand-700">
                            @(string.IsNullOrWhiteSpace(Model.GuardianName) ? "?" : Model.GuardianName.Trim()[..1].ToUpperInvariant())
                        </span>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-gray-900">@(string.IsNullOrWhiteSpace(Model.GuardianName) ? "Not recorded" : Model.GuardianName)</p>
                            <p class="text-xs text-gray-500">Guardian</p>
                        </div>
                    </div>
                    <dl class="mt-4 divide-y divide-gray-100">
                        @Row(("Phone", Model.PhoneNumber, true))
                        @Row(("Relation", null, false))
                    </dl>
                    <div class="mt-4 grid grid-cols-2 gap-2">
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <a href="tel:@Model.PhoneNumber" class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-3 py-2 text-sm font-medium text-white hover:bg-brand-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-100">
                                <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.4 18.2a12 12 0 0 1-11.6-11.6c0-.8.6-1.5 1.4-1.6l2-.3a1 1 0 0 1 1.1.7l.8 2.6a1 1 0 0 1-.4 1.1l-1 .7a9 9 0 0 0 3.9 3.9l.7-1a1 1 0 0 1 1.1-.4l2.6.8a1 1 0 0 1 .7 1.1l-.3 2c-.1.8-.8 1.4-1.6 1.4Z"/></svg>
                                Call
                            </a>
                        }
                        else
                        {
                            <button type="button" disabled class="inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-lg bg-gray-100 px-3 py-2 text-sm font-medium text-gray-400">Call</button>
                        }
                        <button type="button" disabled title="Not available yet" class="inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-400">Message</button>
                    </div>
                </div>
            </section>

            @* Admin quick tools *@
            <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
                <header class="flex items-center gap-2 border-b border-gray-100 px-6 py-4">
                    <span class="h-4 w-0.5 rounded-full bg-brand-500"></span>
                    <h2 class="text-sm font-semibold text-gray-900">Admin quick tools</h2>
                </header>
                <div class="space-y-1 p-3">
                    @if (Model.IsActive)
                    {
                        <form asp-controller="Student" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Deactivate this student? You can reactivate them anytime.');">
                            <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-red-100">
                                <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                Deactivate student
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Student" asp-action="Activate" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-brand-700 hover:bg-brand-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-100">
                                <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11.9 9.2 16 19 6"/></svg>
                                Activate student
                            </button>
                        </form>
                    }
                    <button type="button" disabled title="Not available yet" class="flex w-full cursor-not-allowed items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-gray-300">
                        <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.4 6 18 7.6M6 16v2h2l9.4-9.4a1.4 1.4 0 0 0 0-2L15.8 5a1.4 1.4 0 0 0-2 0L6 14v2Z"/></svg>
                        Edit details
                    </button>
                    <button type="button" disabled title="Not available yet" class="flex w-full cursor-not-allowed items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-gray-300">
                        <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9V4h12v5M6 18H5a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-1m-12 0v3h12v-3M6 18h12"/></svg>
                        Print ID card
                    </button>
                    <button type="button" disabled title="Not available yet" class="flex w-full cursor-not-allowed items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-gray-300">
                        <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h12m0 0-4-4m4 4-4 4m4-9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1"/></svg>
                        Transfer student
                    </button>
                </div>
            </section>

            @* Recent activity *@
            <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
                <header class="flex items-center gap-2 border-b border-gray-100 px-6 py-4">
                    <span class="h-4 w-0.5 rounded-full bg-brand-500"></span>
                    <h2 class="text-sm font-semibold text-gray-900">Recent activity</h2>
                </header>
                <ol class="px-6 py-5">
                    <li class="flex gap-3">
                        <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600">
                            <svg class="h-3.5 w-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        </span>
                        <div>
                            <p class="text-sm text-gray-700">Added to the student roster</p>
                            <p class="text-xs text-gray-400">@(Model.CreatedAt == default ? "—" : Model.CreatedAt.ToString("d MMM yyyy"))</p>
                        </div>
                    </li>
                    <li class="mt-4 text-xs text-gray-400">No further activity recorded yet.</li>
                </ol>
            </section>
        </div>
    </div>
</div>
