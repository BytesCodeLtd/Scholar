@using Scholar.Models.ViewModels
@model IEnumerable<PaperCard>
@{
    ViewData["Title"] = "Saved Papers";
    var count = Model.Count();
    bool isSuperAdmin = ViewBag.IsSuperAdmin ?? false;
    string? search = ViewBag.Search as string;
    bool isSearching = !string.IsNullOrWhiteSpace(search);
    string scope = isSuperAdmin ? "across all institutes" : "for your institute";
    ViewData["PageSubtitle"] = isSearching
        ? $"{count} paper{(count == 1 ? "" : "s")} matching \"{search}\""
        : count == 0
            ? $"Nothing saved {scope} yet"
            : $"{count} paper{(count == 1 ? "" : "s")} saved {scope}";
    // Whether to show the search box even when the current result set is empty.
    bool hasAnyPapers = count > 0 || isSearching;
}

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    @if (hasAnyPapers)
    {
        @* Live search: JS fetches results as you type. The form is a no-JS fallback (Enter submits). *@
        <form asp-controller="Test" asp-action="Index" method="get" role="search" class="relative w-full sm:max-w-xs">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z" /></svg>
            </span>
            <input id="paper-search" name="search" type="text" autocomplete="off" value="@search"
                   placeholder="Search papers..."
                   aria-label="Search saved papers"
                   class="w-full rounded-lg border border-gray-200 bg-white py-2 pl-9 pr-9 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:outline-none focus:ring-4 focus:ring-brand-100" />
            <button id="paper-search-clear" type="button" title="Clear search" aria-label="Clear search"
                    class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-600 @(isSearching ? "" : "hidden")">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
        </form>
    }
    else
    {
        <span></span>
    }
    <a asp-controller="Board" asp-action="Index"
       class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 focus:outline-none focus:ring-4 focus:ring-brand-100">
        +
    </a>
</div>

<div id="paper-results">
    @await Html.PartialAsync("_PaperGrid", Model)
</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('paper-search');
            const results = document.getElementById('paper-results');
            const clearBtn = document.getElementById('paper-search-clear');
            if (!input || !results) return;

            const searchUrl = '@Url.Action("Search", "Test")';

            const debounce = (fn, delay) => {
                let timer;
                return (...args) => {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn(...args), delay);
                };
            };

            const search = async () => {
                const query = input.value.trim();
                clearBtn.classList.toggle('hidden', !query);
                const response = await fetch(`${searchUrl}?search=${encodeURIComponent(query)}`);
                if (response.ok) results.innerHTML = await response.text();
            };

            input.addEventListener('input', debounce(search, 700));
            input.closest('form').addEventListener('submit', e => e.preventDefault());
            clearBtn.addEventListener('click', () => { input.value = ''; input.focus(); search(); });
        })();
    </script>
}
