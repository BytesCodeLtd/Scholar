@{
    // Keep the Papers dropdown expanded when the current page is one of its children.
    // Institute serves both the Institutes tab and Paper Settings, so only its
    // PaperSettings action counts as a paper page.
    string? currentController = ViewContext.RouteData.Values["controller"] as string;
    string? currentAction = ViewContext.RouteData.Values["action"] as string;
    string[] paperControllers = { "Board", "Grade", "Subject", "Chapter", "Test", "PastPaper" };
    bool papersOpen = (currentController is not null && paperControllers.Contains(currentController))
                      || (currentController == "Institute" && currentAction == "PaperSettings");
}
<aside id="sidebar" aria-label="Sidebar"
       class="fixed top-0 left-0 z-40 w-64 h-screen pt-14 transition-transform -translate-x-full sm:translate-x-0">
    <div class="h-full px-3 py-4 overflow-y-auto bg-white border-r border-gray-200">
        <ul class="space-y-2 font-medium">
            <li>
                <a asp-controller="Dashboard" asp-action="Index"
                   class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                    <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z" />
                    </svg>
                    <span class="ms-3">Dashboard</span>
                </a>
            </li>

            <li>
                <button type="button"
                        class="flex items-center w-full p-2 text-gray-900 rounded-lg group hover:bg-gray-100"
                        aria-controls="dropdown-papers" data-collapse-toggle="dropdown-papers"
                        aria-expanded="@(papersOpen ? "true" : "false")">
                    <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M5 0h6.293A1 1 0 0 1 12 .293L15.707 4a1 1 0 0 1 .293.707V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2Zm2 9a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2H7Zm0 4a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2H7Z" />
                    </svg>
                    <span class="flex-1 ms-3 text-left whitespace-nowrap">Examination</span>
                    <svg class="w-3 h-3 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4" />
                    </svg>
                </button>
                <ul id="dropdown-papers" class="@(papersOpen ? "" : "hidden") py-2 space-y-2">
                    <li>
                        <a asp-controller="Board" asp-action="Index"
                           class="flex items-center w-full p-2 pl-6 text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100">
                            <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.3 4.8 2.9 2.9M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.4-10a2 2 0 0 1 0 3l-6.8 6.8L8 14l.7-3.6 6.9-6.8a2 2 0 0 1 2.8 0Z" />
                            </svg>
                            <span class="ms-3">Generate Paper</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Test" asp-action="Index"
                           class="flex items-center w-full p-2 pl-6 text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100">
                            <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 4h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm7 1h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2m0 7h8m-8 4h5" />
                            </svg>
                            <span class="ms-3">Saved Papers</span>
                        </a>
                    </li>
                    @if (User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.InstituteAdmin))
                    {
                        <li>
                            <a asp-controller="PastPaper" asp-action="Index"
                               class="flex items-center w-full p-2 pl-6 text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100">
                                <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8M3 4h18v4H3V4Zm6 8h6" />
                                </svg>
                                <span class="ms-3">Past Papers</span>
                            </a>
                        </li>
                        @if (User.IsInRole(Roles.SuperAdmin))
                        {
                            <li>
                                <a asp-controller="PastPaper" asp-action="Manage"
                                   class="flex items-center w-full p-2 pl-6 text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100">
                                    <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5l4 4M12 5l-4 4M12 5v10M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" />
                                    </svg>
                                    <span class="ms-3">Upload Past Papers</span>
                                </a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Institute" asp-action="PaperSettings"
                               class="flex items-center w-full p-2 pl-6 text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100">
                                <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-600 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.02-.397-1.11-.94l-.213-1.28c-.062-.375-.312-.687-.644-.87a6.52 6.52 0 0 1-.22-.128c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                <span class="ms-3">Paper Settings</span>
                            </a>
                        </li>
                    }
                </ul>
            </li>

            @if (User.IsInRole(Roles.SuperAdmin))
            {
                <li>
                    <a asp-controller="Institute" asp-action="List"
                       class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                        <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4 4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14h1a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2h1V4Zm3 1h2v2H7V5Zm0 4h2v2H7V9Zm4-4h2v2h-2V5Zm0 4h2v2h-2V9Zm-2 4a1 1 0 0 0-1 1v3h4v-3a1 1 0 0 0-1-1h-2Z" clip-rule="evenodd" />
                        </svg>
                        <span class="ms-3">Institutes</span>
                    </a>
                </li>
            }
            @if (User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.InstituteAdmin))
            {
                <li>
                    <a asp-controller="Student" asp-action="Index"
                       class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                        <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-2 1a5.977 5.977 0 0 0-4.242 1.758A6 6 0 0 0 2 16v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1a6 6 0 0 0-1.758-4.242A5.977 5.977 0 0 0 12 10H8Z" />
                        </svg>
                        <span class="ms-3">Students</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Attendance" asp-action="Index"
                       class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                        <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3v4m8-4v4M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 9 2 2 4-4" />
                        </svg>
                        <span class="ms-3">Attendance</span>
                    </a>
                </li>
            }
            <li>
                <a asp-controller="Teacher" asp-action="Index"
                   class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
                    <svg class="w-5 h-5 text-gray-500 group-hover:text-brand-600" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14 3 9l9-5 9 5-9 5Zm0 0v6m6-9.333V16a6 6 0 0 1-12 0v-2.333" />
                    </svg>
                    <span class="ms-3">Teachers</span>
                </a>
            </li>
        </ul>
    </div>
</aside>
