@using Scholar.Common
@model Scholar.Models.ViewModels.InvoiceDetailsViewModel
@{
    ViewData["Title"] = $"Invoice · {Model.StudentName}";
    string field = "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5";
    string label = "mb-1 block text-sm font-medium text-gray-900";

    (string cls, string text) badge = Model.Status == Scholar.Enums.InvoiceStatus.Paid
        ? ("bg-emerald-50 text-emerald-700", "Paid")
        : Model.IsOverdue
            ? ("bg-rose-50 text-rose-700", "Overdue")
            : Model.Status == Scholar.Enums.InvoiceStatus.Partial
                ? ("bg-amber-50 text-amber-700", "Partial")
                : ("bg-gray-100 text-gray-600", "Unpaid");
}

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    @* Invoice / challan *@
    <div class="lg:col-span-2 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">@Model.StudentName</h2>
                <p class="text-sm text-gray-500">
                    @Model.Class@(string.IsNullOrEmpty(Model.Section) ? "" : $" · {Model.Section}")
                    @(string.IsNullOrEmpty(Model.RollNumber) ? "" : $" · Roll {Model.RollNumber}")
                </p>
                <p class="text-sm text-gray-500">@Model.Institute</p>
            </div>
            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold @badge.cls">@badge.text</span>
        </div>

        <div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm">
            <div><span class="text-gray-400">Period:</span> <span class="font-medium text-gray-900">@Model.Period</span></div>
            <div><span class="text-gray-400">Due:</span> <span class="font-medium text-gray-900">@Model.DueDate.ToString("dd MMM yyyy")</span></div>
        </div>

        <table class="mt-5 w-full text-sm">
            <thead class="border-b border-gray-200 text-left text-xs uppercase text-gray-500">
                <tr><th class="py-2">Item</th><th class="py-2 text-right">Amount</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="py-2 text-gray-800">@item.Description</td>
                        <td class="py-2 text-right text-gray-800">@Money.Pkr(item.Amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="border-t border-gray-200 font-semibold">
                <tr><td class="py-2 text-gray-900">Total</td><td class="py-2 text-right text-gray-900">@Money.Pkr(Model.Total)</td></tr>
                <tr><td class="py-1 text-emerald-700">Paid</td><td class="py-1 text-right text-emerald-700">@Money.Pkr(Model.Paid)</td></tr>
                <tr><td class="py-1 text-brand-700">Balance</td><td class="py-1 text-right text-brand-700">@Money.Pkr(Model.Balance)</td></tr>
            </tfoot>
        </table>

        @if (Model.Payments.Count > 0)
        {
            <h3 class="mt-6 mb-2 text-sm font-semibold text-gray-900">Payment history</h3>
            <table class="w-full text-sm">
                <thead class="border-b border-gray-200 text-left text-xs uppercase text-gray-500">
                    <tr><th class="py-2">Date</th><th class="py-2">Method</th><th class="py-2">Note</th><th class="py-2 text-right">Amount</th></tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td class="py-2 text-gray-700">@p.PaidOn.ToString("dd MMM yyyy")</td>
                            <td class="py-2 text-gray-700">@p.Method</td>
                            <td class="py-2 text-gray-500">@p.Note</td>
                            <td class="py-2 text-right text-gray-800">@Money.Pkr(p.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* Actions *@
    <div class="space-y-6">
        @if (Model.Balance > 0)
        {
            <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
                <h3 class="mb-3 text-sm font-semibold text-gray-900">Record payment</h3>
                <form asp-controller="Fees" asp-action="RecordPayment" asp-route-id="@Model.Id" method="post" class="space-y-3">
                    <div>
                        <label class="@label">Amount (Rs.)</label>
                        <input name="amount" type="number" min="1" step="1" value="@Model.PaymentAmount" class="@field" />
                    </div>
                    <div>
                        <label class="@label">Paid on</label>
                        <input name="paidOn" type="date" value="@Model.PaymentDate.ToString("yyyy-MM-dd")" class="@field" />
                    </div>
                    <div>
                        <label class="@label">Method</label>
                        <select name="method" asp-items="Html.GetEnumSelectList<Scholar.Enums.PaymentMethod>()" class="@field"></select>
                    </div>
                    <div>
                        <label class="@label">Note (optional)</label>
                        <input name="note" class="@field" placeholder="Reference / remarks" />
                    </div>
                    <button type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Record payment</button>
                </form>
            </div>
        }

        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm space-y-2">
            <form asp-controller="Fees" asp-action="SendReminder" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Email reminder</button>
            </form>
            <button type="button" onclick="window.print()" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Print challan</button>
            <a asp-action="Index" class="block text-center rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700">Back to invoices</a>
        </div>
    </div>
</div>
