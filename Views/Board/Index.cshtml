@model IEnumerable<Board>
@{
    ViewData["Title"] = "Boards";
}

@if (!Model.Any())
{
    <div class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-200 bg-white px-6 py-16 text-center">
        <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-brand-50 text-brand-600">
            <svg class="w-7 h-7" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0H5m14 0h2m-2 0h-4m-6 0H3m2 0h4m0 0v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4m-4 0h4" />
            </svg>
        </span>
        <h2 class="mt-4 text-base font-semibold text-gray-900">No boards yet</h2>
        <p class="mt-1 max-w-sm text-sm text-gray-500">
            Examination boards will appear here once they've been added.
        </p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        @foreach (var board in Model)
        {
            string initial = string.IsNullOrWhiteSpace(board.Name) ? "?" : board.Name.Trim()[..1].ToUpper();

            <a asp-controller="Grade" asp-action="Index" asp-route-boardId="@board.Id"
               class="group relative flex flex-col overflow-hidden rounded-2xl bg-white border border-gray-200 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-600/10 hover:border-brand-500/40 focus:outline-none focus:ring-4 focus:ring-brand-100 motion-reduce:transition-none motion-reduce:hover:translate-y-0">

                @* Oversized faint initial, bleeding off the bottom-right corner like a watermark. *@
                <span aria-hidden="true" class="pointer-events-none absolute -bottom-8 -right-2 select-none text-[9rem] font-bold leading-none text-gray-100 z-0 transition-colors duration-200 group-hover:text-brand-100">@initial</span>

                <div class="relative z-10 flex h-full flex-col p-5">
                    <div class="flex items-start justify-between">
                        @* Monogram stamp. *@
                        <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-600 text-white text-xl font-bold shadow-sm">
                            @initial
                        </span>
                        <div class="flex flex-col items-end gap-2">
                            <span class="rounded-full bg-brand-50 px-3 py-1 text-[11px] font-semibold text-brand-700">Est. @board.CreatedAt.Year</span>
                        </div>
                    </div>

                    <div class="mt-6">
                        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-600">Examination Board</p>
                        <h2 class="mt-1 text-2xl font-bold leading-tight text-gray-900 line-clamp-2 group-hover:text-brand-700">@board.Name</h2>
                    </div>

                    <div class="mt-auto flex items-center justify-between pt-8">
                        <span class="text-sm font-semibold text-brand-700">Explore Grades</span>
                        <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 text-brand-600 transition duration-200 group-hover:border-brand-600 group-hover:bg-brand-600 group-hover:text-white">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0-5 5m5-5H6" /></svg>
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>
}
