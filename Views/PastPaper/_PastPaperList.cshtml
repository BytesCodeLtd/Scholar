@model IEnumerable<Scholar.Models.PastPaper>

@if (!Model.Any())
{
    <div class="rounded-lg border border-dashed border-gray-200 bg-white px-6 py-12 text-center text-sm text-gray-500">
        No past papers found for this subject yet.
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
        @foreach (var paper in Model)
        {
            <article class="group relative flex flex-col overflow-hidden rounded-xl bg-white border border-gray-200 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-brand-600/10 hover:border-brand-500/40 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                <span class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-red-500 to-red-700 transition-all duration-200 group-hover:w-1.5"></span>

                <div class="flex items-start gap-3 px-5 pt-5">
                    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-600">
                        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 0h6.293A1 1 0 0 1 12 .293L15.707 4a1 1 0 0 1 .293.707V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2Z" />
                        </svg>
                    </span>
                    <div class="min-w-0 flex-1">
                        <h3 class="text-base font-semibold leading-snug text-gray-900 line-clamp-2 group-hover:text-brand-700">
                            @paper.Title
                        </h3>
                        @if (paper.Year is not null)
                        {
                            <span class="mt-1.5 inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600">
                                @paper.Year
                            </span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(paper.OriginalFileName))
                {
                    <p class="mt-3 px-5 truncate text-xs text-gray-400" title="@paper.OriginalFileName">
                        @paper.OriginalFileName
                    </p>
                }

                <div class="mt-4 border-t border-dashed border-gray-200"></div>

                <div class="px-5 py-3">
                    <a href="@paper.FileUrl" target="_blank" rel="noopener"
                       class="inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-brand-600 px-3 py-2 text-sm font-medium text-white hover:bg-brand-700 focus:outline-none focus:ring-4 focus:ring-brand-100">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M10 1v12m0 0 4-4m-4 4-4-4M1 15v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2" />
                        </svg>
                        Download
                    </a>
                </div>
            </article>
        }
    </div>
}
