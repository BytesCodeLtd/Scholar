@model Scholar.Models.ViewModels.FeeCategoryFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "New Fee Category" : "Edit Fee Category";
    string field = "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand-500 focus:border-brand-500 block w-full p-2.5";
    string label = "mb-1 block text-sm font-medium text-gray-900";
    string err = "mt-1 block text-sm text-red-600";
}

<div class="max-w-lg rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <form asp-controller="Fees" asp-action="SaveCategory" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg p-3"></div>

        <input type="hidden" asp-for="Id" />

        @if (Model.ShowInstitute)
        {
            <div>
                <label asp-for="InstituteId" class="@label">Institute</label>
                <select asp-for="InstituteId" asp-items="Model.InstituteOptions" class="@field" data-searchable>
                    <option value="">Select institute</option>
                </select>
                <span asp-validation-for="InstituteId" class="@err"></span>
            </div>
        }

        <div>
            <label asp-for="Name" class="@label"></label>
            <input asp-for="Name" class="@field" placeholder="e.g. Tuition, Admission, Transport" />
            <span asp-validation-for="Name" class="@err"></span>
        </div>

        <div>
            <label asp-for="DefaultAmount" class="@label"></label>
            <input asp-for="DefaultAmount" type="number" min="0" step="1" class="@field" placeholder="0" />
            <span asp-validation-for="DefaultAmount" class="@err"></span>
            <p class="mt-1 text-xs text-gray-500">Pre-filled when generating invoices; you can override it per class.</p>
        </div>

        <div class="flex items-center gap-2">
            <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Save</button>
            <a asp-action="Categories" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
